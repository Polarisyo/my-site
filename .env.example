# 复制为 .env 并填入真实值（.gitignore 已忽略 .env / .env.production）

# GitHub fine-grained PAT：需对 dataInMySite（Contents 读写）和 my-site（git refs/trees/commits 写，用于 bump submodule 指针）均有写权限
GITHUB_TOKEN=

# GitHub 仓库配置
GITHUB_OWNER=Polarisyo
GITHUB_CONTENT_REPO=dataInMySite
GITHUB_SITE_REPO=my-site
GITHUB_SITE_BRANCH=master

# 管理员密码哈希，格式 salt:hash（运行 npm run hash-password 生成）
ADMIN_PASSWORD_HASH=

# 会话签名密钥，32 字节 hex 随机串（独立，不要复用 GITHUB_TOKEN）
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
