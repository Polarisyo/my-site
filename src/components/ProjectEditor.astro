---
// 项目（projects）编辑器表单，新建 / 编辑共用。
// new 模式：POST /api/projects；edit 模式：PUT /api/projects/[slug]（带 sha）。
interface Initial {
  name?: string;
  description?: string;
  techStack?: string[] | string;
  demoUrl?: string;
  repoUrl?: string;
  status?: string;
  featured?: boolean;
  body?: string;
}
interface Props {
  mode: 'new' | 'edit';
  slug?: string;
  sha?: string;
  initial?: Initial;
}
const { mode, slug = '', sha = '', initial = {} } = Astro.props;
const techStr = Array.isArray(initial.techStack) ? initial.techStack.join(', ') : initial.techStack || '';
const status = initial.status || 'active';
---

<form id="project-form" class="project-form" data-mode={mode} data-slug={slug} data-sha={sha}>
  <div class="form-row">
    <label class="form-field form-field-grow">
      <span class="form-label">名称 *</span>
      <input name="name" type="text" required value={initial.name || ''} placeholder="项目名称" />
    </label>
    <label class="form-field form-field-slug">
      <span class="form-label">slug</span>
      <input
        name="slug"
        type="text"
        value={slug}
        placeholder="留空自动生成"
        {mode === 'edit' ? 'readonly' : ''}
      />
    </label>
  </div>

  <label class="form-field">
    <span class="form-label">描述 *</span>
    <input name="description" type="text" required value={initial.description || ''} placeholder="一句话介绍项目" />
  </label>

  <div class="form-row">
    <label class="form-field">
      <span class="form-label">源代码地址 *</span>
      <input name="repoUrl" type="url" required value={initial.repoUrl || ''} placeholder="https://github.com/..." />
    </label>
    <label class="form-field">
      <span class="form-label">在线演示</span>
      <input name="demoUrl" type="url" value={initial.demoUrl || ''} placeholder="https://...（可选）" />
    </label>
  </div>

  <div class="form-row">
    <label class="form-field">
      <span class="form-label">技术栈（逗号分隔）</span>
      <input name="techStack" type="text" value={techStr} placeholder="React, TypeScript, Vite" />
    </label>
    <label class="form-field">
      <span class="form-label">状态</span>
      <select name="status">
        <option value="active" selected={status === 'active'}>进行中</option>
        <option value="concept" selected={status === 'concept'}>概念</option>
        <option value="archived" selected={status === 'archived'}>已归档</option>
      </select>
    </label>
    <label class="form-field form-field-featured">
      <input name="featured" type="checkbox" checked={initial.featured === true} />
      <span>精选</span>
    </label>
  </div>

  <label class="form-field">
    <span class="form-label">正文（Markdown）</span>
    <textarea name="body" rows="16" placeholder="## 项目介绍&#10;&#10;详细介绍…">{initial.body || ''}</textarea>
  </label>

  <div class="form-actions">
    <button type="submit" class="btn-primary" id="submit-btn">
      {mode === 'new' ? '创建项目' : '保存修改'}
    </button>
    <a href="/admin/projects" class="btn-ghost">取消</a>
    <span id="form-msg" class="form-msg"></span>
  </div>
</form>

<script is:inline>
  (function () {
    var form = document.getElementById('project-form');
    if (!form) return;
    var mode = form.getAttribute('data-mode');
    var slug = form.getAttribute('data-slug') || '';
    var sha = form.getAttribute('data-sha') || '';
    var btn = document.getElementById('submit-btn');
    var msg = document.getElementById('form-msg');

    form.addEventListener('submit', function (e) {
      e.preventDefault();
      msg.textContent = '';
      msg.className = 'form-msg';
      btn.disabled = true;
      btn.textContent = '保存中…';

      var data = {
        name: form.name.value.trim(),
        slug: form.slug ? form.slug.value.trim() : '',
        description: form.description.value.trim(),
        repoUrl: form.repoUrl.value.trim(),
        demoUrl: form.demoUrl.value.trim(),
        techStack: form.techStack.value.trim(),
        status: form.status.value,
        featured: form.featured.checked,
        body: form.body.value,
      };
      if (mode === 'edit') data.sha = sha;

      var url = mode === 'new' ? '/api/projects' : '/api/projects/' + encodeURIComponent(slug);
      var method = mode === 'new' ? 'POST' : 'PUT';

      fetch(url, {
        method: method,
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      })
        .then(function (res) {
          return res.json().then(function (j) {
            return { status: res.status, json: j };
          });
        })
        .then(function (r) {
          if (r.status >= 200 && r.status < 300 && r.json.ok) {
            msg.textContent = mode === 'new' ? '已创建，公开站稍后自动重建…' : '已保存，公开站稍后自动重建…';
            msg.className = 'form-msg success';
            setTimeout(function () {
              window.location.href = '/admin/projects';
            }, 800);
          } else {
            msg.textContent = r.json.error || ('保存失败（' + r.status + '）');
            msg.className = 'form-msg error';
            btn.disabled = false;
            btn.textContent = mode === 'new' ? '创建项目' : '保存修改';
          }
        })
        .catch(function (err) {
          msg.textContent = '网络错误：' + err.message;
          msg.className = 'form-msg error';
          btn.disabled = false;
          btn.textContent = mode === 'new' ? '创建项目' : '保存修改';
        });
    });
  })();
</script>

<style>
  .project-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .form-row {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    align-items: flex-end;
  }

  .form-field {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    flex: 1;
  }

  .form-field-grow {
    flex: 2 1 200px;
  }

  .form-field-slug {
    flex: 1 1 140px;
  }

  .form-field-featured {
    flex-direction: row;
    align-items: center;
    gap: 0.5rem;
    padding-bottom: 0.5rem;
    flex: 0 0 auto;
  }

  .form-label {
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-text-secondary);
  }

  .project-form input[type='text'],
  .project-form input[type='url'],
  .project-form select,
  .project-form textarea {
    width: 100%;
    padding: 0.625rem 0.75rem;
    font-size: 0.9375rem;
    background-color: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    color: var(--color-text);
    outline: none;
    transition: border-color 0.2s, box-shadow 0.2s;
    font-family: inherit;
  }

  .project-form input:focus,
  .project-form select:focus,
  .project-form textarea:focus {
    border-color: var(--color-accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-accent) 20%, transparent);
  }

  .project-form input[readonly] {
    background-color: var(--color-bg-secondary);
    color: var(--color-text-muted);
    cursor: not-allowed;
  }

  .project-form textarea {
    resize: vertical;
    line-height: 1.6;
    font-family: ui-monospace, 'SFMono-Regular', 'Menlo', monospace;
    font-size: 0.875rem;
  }

  .form-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  .btn-primary {
    padding: 0.5rem 1.25rem;
    font-size: 0.9375rem;
    font-weight: 500;
    color: white;
    background-color: var(--color-accent);
    border: none;
    border-radius: var(--radius-md);
    cursor: pointer;
    transition: background-color 0.2s;
  }

  .btn-primary:hover:not(:disabled) {
    background-color: var(--color-accent-hover);
  }

  .btn-primary:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .btn-ghost {
    padding: 0.5rem 1rem;
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
    text-decoration: none;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    transition: color 0.2s, border-color 0.2s;
  }

  .btn-ghost:hover {
    color: var(--color-text);
    border-color: var(--color-text-muted);
  }

  .form-msg {
    font-size: 0.8125rem;
  }

  .form-msg.success {
    color: #059669;
  }

  .form-msg.error {
    color: #dc2626;
  }
</style>
