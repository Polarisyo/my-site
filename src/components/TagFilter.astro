---
interface Props {
  tags: string[];
  activeTag?: string;
  baseUrl?: string;
}

const { tags, activeTag, baseUrl = '/blog' } = Astro.props;
const sortedTags = [...tags].sort();
---

<div class="tag-filter" data-tag-filter>
  <a
    href={baseUrl}
    data-tag=""
    class={`tag-chip ${!activeTag ? 'active' : ''}`}
  >
    全部
  </a>
  {sortedTags.map((tag) => (
    <a
      href={`${baseUrl}?tag=${encodeURIComponent(tag)}`}
      data-tag={tag}
      class={`tag-chip ${activeTag === tag ? 'active' : ''}`}
    >
      {tag}
    </a>
  ))}
</div>

<style>
  .tag-filter {
    display: flex;
    gap: 0.5rem;
    overflow-x: auto;
    padding-bottom: 0.5rem;
    margin-bottom: 1.5rem;
    scrollbar-width: thin;
  }

  .tag-filter::-webkit-scrollbar {
    height: 4px;
  }

  .tag-filter::-webkit-scrollbar-thumb {
    background-color: var(--color-border);
    border-radius: 2px;
  }

  .tag-chip {
    display: inline-flex;
    align-items: center;
    padding: 0.25rem 0.75rem;
    font-size: 0.8125rem;
    font-weight: 500;
    border-radius: 9999px;
    background-color: var(--color-bg-secondary);
    color: var(--color-text-secondary);
    text-decoration: none;
    white-space: nowrap;
    transition: background-color 0.2s, color 0.2s;
    flex-shrink: 0;
  }

  .tag-chip:hover {
    color: var(--color-text);
  }

  .tag-chip.active {
    background-color: var(--color-accent);
    color: white;
  }
</style>