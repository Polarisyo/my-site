---
import '../assets/styles/global.css';
import Sidebar from '../components/Sidebar.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ThemeToggle from '../components/ThemeToggle.astro';

interface Props {
  title?: string;
  description?: string;
}

const { title = 'My Site', description = '个人数字花园 · 记录思考，沉淀知识' } = Astro.props;
const pageTitle = title === 'My Site' ? title : `${title} · My Site`;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <script is:inline>
      (function () {
        var theme = localStorage.getItem('theme');
        var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (theme === 'dark' || (!theme && prefersDark)) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>
  </head>
  <body>
    <a href="#main" class="skip-link">跳至主要内容</a>

    <Header>
      <div slot="header-actions" style="display: flex; align-items: center; gap: 0.5rem;">
        <button class="search-btn" data-search-toggle aria-label="搜索" title="搜索">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <path d="m21 21-4.3-4.3"></path>
          </svg>
        </button>
        <ThemeToggle />
      </div>
    </Header>

    <Sidebar />

    <div class="sidebar-spacer"></div>

    <main id="main" class="main-content">
      <div class="main-inner">
        <div class="top-bar">
          <div class="top-bar-actions">
            <button class="search-btn" data-search-toggle aria-label="搜索" title="搜索">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"></circle>
                <path d="m21 21-4.3-4.3"></path>
              </svg>
            </button>
            <ThemeToggle />
          </div>
        </div>
        <slot />
      </div>
      <Footer />
    </main>

    <div id="search-modal" class="search-modal" aria-hidden="true">
      <div class="search-modal-backdrop" data-search-close></div>
      <div class="search-modal-dialog" role="dialog" aria-modal="true" aria-label="搜索">
        <div class="search-modal-box">
          <div class="search-modal-input-wrap">
            <svg class="search-modal-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"/>
              <path d="m21 21-4.3-4.3"/>
            </svg>
            <input
              id="search-modal-input"
              type="text"
              class="search-modal-input"
              placeholder="搜索博客、笔记、项目…"
              autocomplete="off"
              spellcheck="false"
            />
            <kbd class="search-modal-kbd">ESC</kbd>
          </div>
          <div id="search-modal-results" class="search-modal-results"></div>
          <div id="search-modal-footer" class="search-modal-footer">
            <span class="search-modal-hint"><kbd>↑</kbd><kbd>↓</kbd> 导航</span>
            <span class="search-modal-hint"><kbd>Enter</kbd> 选择</span>
            <span class="search-modal-hint"><kbd>Esc</kbd> 关闭</span>
          </div>
        </div>
      </div>
    </div>

    <button id="back-to-top" class="back-to-top" aria-label="回到顶部" title="回到顶部">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="m18 15-6-6-6 6"/>
      </svg>
    </button>

    <script is:inline>
      (function () {
        var menuToggle = document.getElementById('menu-toggle');
        var sidebar = document.querySelector('.sidebar');
        var overlay = document.getElementById('sidebar-overlay');

        function openSidebar() {
          sidebar.classList.add('open');
          overlay.classList.add('show');
        }

        function closeSidebar() {
          sidebar.classList.remove('open');
          overlay.classList.remove('show');
        }

        if (menuToggle) {
          menuToggle.addEventListener('click', function () {
            if (sidebar.classList.contains('open')) {
              closeSidebar();
            } else {
              openSidebar();
            }
          });
        }

        if (overlay) {
          overlay.addEventListener('click', closeSidebar);
        }

        var backToTop = document.getElementById('back-to-top');
        if (backToTop) {
          backToTop.addEventListener('click', function () {
            window.scrollTo({ top: 0, behavior: 'smooth' });
          });
        }

        function updateBackToTop() {
          if (!backToTop) return;
          if (window.scrollY > 300) {
            backToTop.classList.add('show');
          } else {
            backToTop.classList.remove('show');
          }
        }

        window.addEventListener('scroll', function () {
          if (window.innerWidth > 1024 && sidebar.classList.contains('open')) {
            closeSidebar();
          }
          updateBackToTop();
        });

        updateBackToTop();

        document.addEventListener('click', function (e) {
          var toggle = e.target.closest('[data-theme-toggle]');
          if (toggle) {
            var html = document.documentElement;
            var isDark = html.classList.contains('dark');
            if (isDark) {
              html.classList.remove('dark');
              localStorage.setItem('theme', 'light');
            } else {
              html.classList.add('dark');
              localStorage.setItem('theme', 'dark');
            }
            return;
          }

          var searchToggle = e.target.closest('[data-search-toggle]');
          if (searchToggle) {
            openSearch();
          }

          var searchClose = e.target.closest('[data-search-close]');
          if (searchClose) {
            closeSearch();
          }
        });

        var searchModal = document.getElementById('search-modal');
        var searchInput = document.getElementById('search-modal-input');
        var searchResults = document.getElementById('search-modal-results');
        var searchFooter = document.getElementById('search-modal-footer');
        var searchDocs = [];
        var searchLoaded = false;
        var searchActiveIndex = -1;

        function openSearch() {
          if (!searchModal) return;
          searchModal.classList.add('show');
          searchModal.setAttribute('aria-hidden', 'false');
          document.body.style.overflow = 'hidden';
          setTimeout(function () {
            searchInput.focus();
            searchInput.select();
          }, 10);
          if (!searchLoaded) {
            fetchSearchData();
          }
        }

        function closeSearch() {
          if (!searchModal) return;
          searchModal.classList.remove('show');
          searchModal.setAttribute('aria-hidden', 'true');
          document.body.style.overflow = '';
          searchInput.value = '';
          searchResults.innerHTML = '';
          searchActiveIndex = -1;
          updateFooter('idle');
        }

        function fetchSearchData() {
          fetch('/search-data.json')
            .then(function (res) { return res.json(); })
            .then(function (data) {
              searchDocs = data;
              searchLoaded = true;
            })
            .catch(function () {
              searchLoaded = false;
            });
        }

        function runSearch(query) {
          if (!searchLoaded) {
            searchResults.innerHTML = '<div class="search-modal-empty">搜索加载中…</div>';
            updateFooter('loading');
            return;
          }
          query = query.trim();
          if (!query) {
            searchResults.innerHTML = '';
            searchActiveIndex = -1;
            updateFooter('idle');
            return;
          }

          var queryLower = query.toLowerCase();
          var matched = searchDocs.filter(function (doc) {
            var haystack = [
              doc.title,
              doc.description || '',
              (doc.tags || []).join(' '),
              doc.body || ''
            ].join(' ').toLowerCase();
            return haystack.indexOf(queryLower) !== -1;
          });

          matched.sort(function (a, b) {
            return getScore(b, queryLower) - getScore(a, queryLower);
          });

          searchActiveIndex = -1;
          renderResults(matched.slice(0, 8), query);
        }

        function getScore(doc, query) {
          var score = 0;
          if ((doc.title || '').toLowerCase().indexOf(query) !== -1) score += 100;
          if ((doc.tags || []).join(' ').toLowerCase().indexOf(query) !== -1) score += 50;
          if ((doc.description || '').toLowerCase().indexOf(query) !== -1) score += 30;
          if ((doc.body || '').toLowerCase().indexOf(query) !== -1) score += 10;
          return score;
        }

        function renderResults(items, query) {
          searchResults.innerHTML = '';
          if (items.length === 0) {
            searchResults.innerHTML = '<div class="search-modal-empty">没有找到与 "' + query + '" 相关的内容</div>';
            updateFooter('noresults');
            return;
          }
          updateFooter('results', items.length);
          items.forEach(function (doc, i) {
            var typeLabel = { blog: '博客', notes: '笔记', projects: '项目' };
            var typeClass = { blog: 'tag-blog', notes: 'tag-notes', projects: 'tag-projects' };
            var item = document.createElement('a');
            item.href = doc.url;
            item.className = 'search-result-item';
            item.dataset.index = i;
            item.innerHTML =
              '<div class="result-title">' + highlight(doc.title, query) + '</div>' +
              '<div class="result-meta">' +
                '<span class="result-tag tag ' + (typeClass[doc.type] || '') + '">' + (typeLabel[doc.type] || doc.type) + '</span>' +
                (doc.date ? '<span class="result-date">' + formatDate(doc.date) + '</span>' : '') +
              '</div>' +
              (doc.description ? '<div class="result-desc">' + highlight(doc.description, query) + '</div>' : '');
            searchResults.appendChild(item);
          });
        }

        function highlight(text, query) {
          if (!query) return text;
          var escaped = query.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
          return text.replace(new RegExp('(' + escaped + ')', 'gi'), '<mark>$1</mark>');
        }

        function formatDate(iso) {
          try {
            var d = new Date(iso);
            return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
          } catch (e) { return ''; }
        }

        function updateFooter(state, count) {
          if (state === 'idle') {
            searchFooter.innerHTML = '<span class="search-modal-hint"><kbd>/</kbd> 聚焦</span><span class="search-modal-hint"><kbd>Esc</kbd> 关闭</span>';
          } else if (state === 'results') {
            searchFooter.innerHTML = '<span class="search-modal-hint">' + count + ' 条结果</span><span class="search-modal-hint"><kbd>↑</kbd><kbd>↓</kbd> 导航</span><span class="search-modal-hint"><kbd>Enter</kbd> 选择</span>';
          } else if (state === 'noresults') {
            searchFooter.innerHTML = '<span class="search-modal-hint">无匹配结果</span>';
          } else {
            searchFooter.innerHTML = '<span class="search-modal-hint">加载中…</span>';
          }
        }

        searchInput.addEventListener('input', function (e) {
          runSearch(e.target.value);
        });

        searchResults.addEventListener('click', function (e) {
          var item = e.target.closest('.search-result-item');
          if (item) {
            e.preventDefault();
            window.location.href = item.href;
          }
        });

        searchInput.addEventListener('keydown', function (e) {
          var items = searchResults.querySelectorAll('.search-result-item');
          if (e.key === 'ArrowDown') {
            e.preventDefault();
            searchActiveIndex = Math.min(searchActiveIndex + 1, items.length - 1);
            updateActiveItem(items);
          } else if (e.key === 'ArrowUp') {
            e.preventDefault();
            searchActiveIndex = Math.max(searchActiveIndex - 1, -1);
            updateActiveItem(items);
          } else if (e.key === 'Enter') {
            if (searchActiveIndex >= 0 && items[searchActiveIndex]) {
              e.preventDefault();
              window.location.href = items[searchActiveIndex].href;
            } else if (items.length > 0) {
              e.preventDefault();
              window.location.href = items[0].href;
            }
          } else if (e.key === 'Escape') {
            e.preventDefault();
            closeSearch();
          }
        });

        function updateActiveItem(items) {
          items.forEach(function (el, i) {
            if (i === searchActiveIndex) {
              el.classList.add('active');
            } else {
              el.classList.remove('active');
            }
          });
        }

        document.addEventListener('keydown', function (e) {
          if (e.key === '/' && document.activeElement !== searchInput) {
            e.preventDefault();
            openSearch();
          }
          if (e.key === 'Escape' && searchModal && searchModal.classList.contains('show')) {
            closeSearch();
          }
        });
      })();
    </script>
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    top: -100%;
    left: 1rem;
    background: var(--color-accent);
    color: white;
    padding: 0.5rem 1rem;
    border-radius: var(--radius-md);
    z-index: 100;
    transition: top 0.2s;
  }

  .skip-link:focus {
    top: 1rem;
  }

  .sidebar-spacer {
    display: none;
  }

  .main-content {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    background-color: var(--color-bg);
  }

  .main-inner {
    flex: 1;
    max-width: 1024px;
    margin: 0 auto;
    padding: 2rem 1.5rem 0;
    width: 100%;
  }

  .top-bar {
    display: none;
    justify-content: flex-end;
    margin-bottom: 1.5rem;
  }

  .top-bar-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .search-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    background-color: var(--color-bg-card);
    color: var(--color-text-secondary);
    text-decoration: none;
    transition: color 0.2s, background-color 0.2s;
  }

  .search-btn:hover {
    color: var(--color-text);
    background-color: var(--color-bg-secondary);
  }

  .search-btn svg {
    width: 1.125rem;
    height: 1.125rem;
  }

  @media (min-width: 1025px) {
    .sidebar-spacer {
      display: block;
      width: 260px;
      height: 100vh;
      position: fixed;
      top: 0;
      left: 0;
    }

    .main-content {
      margin-left: 260px;
    }

    .main-inner {
      padding: 3rem 2rem 0;
    }

    .top-bar {
      display: flex;
    }
  }

  @media (max-width: 768px) {
    .main-inner {
      padding: 1.5rem 1rem 0;
    }
  }

  .back-to-top {
    position: fixed;
    right: 1.5rem;
    bottom: 1.5rem;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--radius-full);
    background-color: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    color: var(--color-text-secondary);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    opacity: 0;
    transform: translateY(1rem);
    transition: opacity 0.25s ease, transform 0.25s ease, background-color 0.2s;
    z-index: 40;
    box-shadow: var(--shadow-md);
  }

  .back-to-top:hover {
    background-color: var(--color-border);
    color: var(--color-text);
  }

  .back-to-top.show {
    opacity: 1;
    transform: translateY(0);
  }

  .back-to-top svg {
    width: 1.25rem;
    height: 1.25rem;
  }

  @media (max-width: 768px) {
    .back-to-top {
      right: 1rem;
      bottom: 1rem;
    }
  }

  .search-modal {
    position: fixed;
    inset: 0;
    z-index: 60;
    display: none;
    align-items: flex-start;
    justify-content: center;
    padding-top: 15vh;
  }

  .search-modal.show {
    display: flex;
  }

  .search-modal-backdrop {
    position: absolute;
    inset: 0;
    background-color: rgba(0, 0, 0, 0.5);
    animation: fadeIn 0.15s ease;
  }

  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  .search-modal-dialog {
    position: relative;
    width: 90%;
    max-width: 38rem;
    animation: slideDown 0.2s ease;
  }

  @keyframes slideDown {
    from { transform: translateY(-1rem); opacity: 0; }
    to { transform: translateY(0); opacity: 1; }
  }

  .search-modal-box {
    background-color: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md), 0 8px 32px rgba(0, 0, 0, 0.12);
    overflow: hidden;
  }

  .search-modal-input-wrap {
    position: relative;
    display: flex;
    align-items: center;
    padding: 0 0.875rem;
    border-bottom: 1px solid var(--color-border);
  }

  .search-modal-icon {
    width: 1.125rem;
    height: 1.125rem;
    color: var(--color-text-muted);
    flex-shrink: 0;
  }

  .search-modal-input {
    flex: 1;
    padding: 0.875rem 0.75rem;
    font-size: 1rem;
    background: transparent;
    border: none;
    color: var(--color-text);
    outline: none;
  }

  .search-modal-input::placeholder {
    color: var(--color-text-muted);
  }

  .search-modal-kbd {
    font-size: 0.7rem;
    padding: 0.125rem 0.375rem;
    color: var(--color-text-muted);
    background-color: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    font-family: inherit;
  }

  .search-modal-results {
    max-height: 22rem;
    overflow-y: auto;
    padding: 0.5rem;
  }

  .search-modal-results .search-result-item {
    display: block;
    padding: 0.625rem 0.75rem;
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: background-color 0.12s;
    cursor: pointer;
  }

  .search-modal-results .search-result-item:hover,
  .search-modal-results .search-result-item.active {
    background-color: color-mix(in srgb, var(--color-accent) 10%, var(--color-bg-secondary));
  }

  .search-modal-results .result-title {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: 0.25rem;
    line-height: 1.4;
  }

  .search-modal-results .result-title mark,
  .search-modal-results .result-desc mark {
    background-color: color-mix(in srgb, var(--color-accent) 25%, transparent);
    color: inherit;
    padding: 0 0.125rem;
    border-radius: 2px;
  }

  .search-modal-results .result-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.25rem;
  }

  .search-modal-results .result-tag {
    font-size: 0.6875rem;
  }

  .search-modal-results .result-tag.tag {
    padding: 0.0625rem 0.375rem;
    border-radius: var(--radius-sm);
    font-weight: 500;
  }

  .search-modal-results .result-date {
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  .search-modal-results .result-desc {
    font-size: 0.8125rem;
    color: var(--color-text-secondary);
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .search-modal-results .search-modal-empty {
    padding: 2rem 1rem;
    text-align: center;
    color: var(--color-text-muted);
    font-size: 0.875rem;
  }

  .search-modal-footer {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    padding: 0.5rem 0.875rem;
    border-top: 1px solid var(--color-border);
    background-color: var(--color-bg-secondary);
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  .search-modal-hint {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }

  .search-modal-hint kbd {
    font-size: 0.6875rem;
    padding: 0.0625rem 0.375rem;
    background-color: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    font-family: inherit;
    color: var(--color-text-secondary);
  }

  .search-modal-hint:first-child {
    margin-right: auto;
  }

  .tag-blog {
    background-color: color-mix(in srgb, #3b82f6 15%, transparent);
    color: #2563eb;
  }

  .tag-notes {
    background-color: color-mix(in srgb, #10b981 15%, transparent);
    color: #059669;
  }

  .tag-projects {
    background-color: color-mix(in srgb, #f59e0b 15%, transparent);
    color: #d97706;
  }

  .dark .tag-blog { color: #60a5fa; }
  .dark .tag-notes { color: #34d399; }
  .dark .tag-projects { color: #fbbf24; }

  @media (max-width: 768px) {
    .search-modal {
      padding-top: 8vh;
    }
    .search-modal-dialog {
      width: 95%;
    }
    .search-modal-footer {
      gap: 0.5rem;
      font-size: 0.6875rem;
    }
  }
</style>