---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allNotes = await getCollection('notes', ({ data }) => !data.draft);

const sortedNotes = allNotes.sort((a, b) => {
  const orderA = a.data.order ?? 999;
  const orderB = b.data.order ?? 999;
  if (orderA !== orderB) return orderA - orderB;
  return a.data.title.localeCompare(b.data.title, 'zh-CN');
});

const categories = [...new Set(sortedNotes.map((n) => n.data.category))];
---

<BaseLayout title="笔记">
  <div class="page-header">
    <h1 class="page-title">笔记</h1>
    <p class="page-desc">学习笔记、技术摘抄与知识整理</p>
  </div>

  {sortedNotes.length === 0 ? (
    <div class="empty-state">
      <p>暂无笔记</p>
    </div>
  ) : (
    <div class="notes-content">
      {categories.map((category) => (
        <section class="category-section">
          <h2 class="category-heading">{category}</h2>
          <ul class="note-list">
            {sortedNotes
              .filter((n) => n.data.category === category)
              .map((note) => (
                <li class="note-item">
                  <a href={`/notes/${note.id}`} class="note-link">
                    <span class="note-title">{note.data.title}</span>
                    {note.data.tags.length > 0 && (
                      <div class="note-tags">
                        {note.data.tags.map((tag) => (
                          <span class="tag">{tag}</span>
                        ))}
                      </div>
                    )}
                  </a>
                </li>
              ))}
          </ul>
        </section>
      ))}
    </div>
  )}
</BaseLayout>

<style>
  .page-header {
    margin-bottom: 1.5rem;
  }

  .page-title {
    font-size: 1.875rem;
    font-weight: 700;
    margin: 0 0 0.375rem;
    letter-spacing: -0.02em;
  }

  .page-desc {
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
    margin: 0;
  }

  .empty-state {
    text-align: center;
    padding: 3rem 0;
    color: var(--color-text-muted);
  }

  .category-section {
    margin-bottom: 2rem;
  }

  .category-heading {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin: 0 0 0.75rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .note-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
  }

  .note-item {
    padding: 0.625rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .note-link {
    display: block;
    padding: 0.5rem 0.75rem;
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: background-color 0.2s, padding-left 0.2s;
  }

  .note-link:hover {
    background-color: var(--color-bg-secondary);
    padding-left: 1rem;
  }

  .note-title {
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-text);
    line-height: 1.5;
  }

  .note-link:hover .note-title {
    color: var(--color-accent);
  }

  .note-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin-top: 0.375rem;
  }

  .tag {
    display: inline-block;
    padding: 0.125rem 0.5rem;
    font-size: 0.6875rem;
    color: var(--color-text-muted);
    background-color: var(--color-bg-secondary);
    border-radius: var(--radius-sm);
    transition: color 0.2s, background-color 0.2s;
  }

  .note-link:hover .tag {
    color: var(--color-accent);
    background-color: var(--color-accent-bg);
  }

  @media (max-width: 768px) {
    .page-title {
      font-size: 1.5rem;
    }
  }
</style>