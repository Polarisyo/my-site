---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { estimateReadingTime } from '../../utils/reading-time';

const statusLabels: Record<string, string> = {
  active: '进行中',
  concept: '概念',
  archived: '已归档',
};

const statusColors: Record<string, string> = {
  active: 'status-active',
  concept: 'status-concept',
  archived: 'status-archived',
};

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { data } = project;
const { Content, headings } = await render(project);
const readingTime = estimateReadingTime(project.body);
---

<BaseLayout title={data.name}>
  <article class="project-detail">
    <nav class="breadcrumbs">
      <a href="/projects" class="breadcrumb-link">项目</a>
      <span class="breadcrumb-sep">›</span>
      <span class="breadcrumb-current">{data.name}</span>
    </nav>

    <header class="project-header">
      <div class="project-title-row">
        <h1 class="project-title">{data.name}</h1>
        <span class={`project-status ${statusColors[data.status]}`}>
          {statusLabels[data.status] ?? data.status}
        </span>
      </div>
      <p class="project-subtitle">{data.description}</p>

      <div class="project-meta">
        {readingTime && (
          <span class="project-meta-item">{readingTime} 分钟阅读</span>
        )}
      </div>

      <div class="project-tech">
        {data.techStack.map((tech) => (
          <span class="tech-tag">{tech}</span>
        ))}
      </div>

      <div class="project-actions">
        {data.demoUrl && (
          <a
            href={data.demoUrl.toString()}
            class="btn btn-primary"
            target="_blank"
            rel="noopener noreferrer"
          >
            在线演示 ↗
          </a>
        )}
        <a
          href={data.repoUrl.toString()}
          class="btn btn-secondary"
          target="_blank"
          rel="noopener noreferrer"
        >
          源代码 ↗
        </a>
      </div>
    </header>

    <div class="project-body prose-content">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .project-detail {
    padding-bottom: 2rem;
  }

  .breadcrumbs {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    margin-bottom: 1.25rem;
  }

  .breadcrumb-link {
    color: var(--color-text-secondary);
    text-decoration: none;
    transition: color 0.2s;
  }

  .breadcrumb-link:hover {
    color: var(--color-accent);
  }

  .breadcrumb-sep {
    color: var(--color-text-muted);
  }

  .breadcrumb-current {
    color: var(--color-text);
  }

  .project-header {
    margin-bottom: 2rem;
  }

  .project-title-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }

  .project-title {
    font-size: 2rem;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: -0.02em;
    margin: 0;
  }

  .project-status {
    font-size: 0.75rem;
    font-weight: 500;
    padding: 0.125rem 0.625rem;
    border-radius: var(--radius-full);
    flex-shrink: 0;
  }

  .status-active {
    color: #10b981;
    background-color: rgba(16, 185, 129, 0.1);
  }

  .status-concept {
    color: #f59e0b;
    background-color: rgba(245, 158, 11, 0.1);
  }

  .status-archived {
    color: #6b7280;
    background-color: rgba(107, 114, 128, 0.1);
  }

  .project-subtitle {
    font-size: 1rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin: 0 0 1rem;
  }

  .project-meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-size: 0.875rem;
    color: var(--color-text-muted);
    margin-bottom: 0.75rem;
  }

  .project-tech {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin-bottom: 1.25rem;
  }

  .tech-tag {
    font-size: 0.75rem;
    padding: 0.25rem 0.625rem;
    color: var(--color-text-secondary);
    background-color: var(--color-bg-secondary);
    border-radius: var(--radius-sm);
  }

  .project-actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    padding: 0.5rem 1rem;
    font-size: 0.875rem;
    font-weight: 500;
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: background-color 0.2s, border-color 0.2s, color 0.2s;
  }

  .btn-primary {
    color: white;
    background-color: var(--color-accent);
  }

  .btn-primary:hover {
    background-color: var(--color-accent-hover);
  }

  .btn-secondary {
    color: var(--color-text);
    background-color: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
  }

  .btn-secondary:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .project-body {
    min-width: 0;
  }

  @media (max-width: 768px) {
    .project-title {
      font-size: 1.5rem;
    }

    .project-title-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.375rem;
    }
  }
</style>