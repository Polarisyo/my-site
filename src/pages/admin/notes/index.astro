---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export const prerender = false;

// 列表用 getCollection（构建快照，零 GitHub API 调用）。
// rebuild 完成后才反映最新增删；编辑页则 live 读 GitHub API。
const allNotes = await getCollection('notes');
const sortedNotes = allNotes.sort((a, b) => {
  const oa = a.data.order ?? 999;
  const ob = b.data.order ?? 999;
  if (oa !== ob) return oa - ob;
  return a.data.title.localeCompare(b.data.title, 'zh-CN');
});
---

<BaseLayout title="笔记管理">
  <div class="admin-header">
    <div>
      <h1 class="admin-title">笔记管理</h1>
      <p class="admin-sub">共 {sortedNotes.length} 篇 · 公开站每次保存后约 1–2 分钟自动重建</p>
    </div>
    <a href="/admin/notes/new" class="btn-new">+ 新建笔记</a>
  </div>

  <div class="admin-list">
    {sortedNotes.length === 0 ? (
      <div class="empty-state">
        <p>暂无笔记</p>
        <a href="/admin/notes/new" class="btn-new">写第一篇</a>
      </div>
    ) : (
      sortedNotes.map((note) => (
        <div class="admin-item" data-slug={note.id}>
          <div class="item-main">
            <span class="item-title">{note.data.title}</span>
            <div class="item-meta">
              <span class="tag">{note.data.category}</span>
              {note.data.draft && <span class="badge-draft">草稿</span>}
              {note.data.order !== undefined && <span class="item-order">#{note.data.order}</span>}
            </div>
          </div>
          <div class="item-actions">
            <a href={`/admin/notes/${note.id}/edit`} class="btn-edit">编辑</a>
            <button type="button" class="btn-delete" data-delete-slug={note.id}>删除</button>
          </div>
        </div>
      ))
    )}
  </div>

  <p id="del-msg" class="del-msg"></p>
</BaseLayout>

<script is:inline>
  (function () {
    var msg = document.getElementById('del-msg');
    document.addEventListener('click', function (e) {
      var btn = e.target.closest('[data-delete-slug]');
      if (!btn) return;
      var slug = btn.getAttribute('data-delete-slug');
      if (!confirm('确认删除笔记「' + slug + '」？此操作会从仓库移除文件并触发重建，不可撤销。')) return;

      msg.textContent = '删除中…';
      msg.className = 'del-msg';
      btn.disabled = true;

      fetch('/api/notes/' + encodeURIComponent(slug), { method: 'DELETE' })
        .then(function (res) {
          return res.json().then(function (j) {
            return { status: res.status, json: j };
          });
        })
        .then(function (r) {
          if (r.status >= 200 && r.status < 300 && r.json.ok) {
            var item = document.querySelector('.admin-item[data-slug="' + slug + '"]');
            if (item) item.remove();
            msg.textContent = '已删除，公开站稍后自动重建…';
            msg.className = 'del-msg success';
          } else {
            msg.textContent = r.json.error || '删除失败';
            msg.className = 'del-msg error';
            btn.disabled = false;
          }
        })
        .catch(function (err) {
          msg.textContent = '网络错误：' + err.message;
          msg.className = 'del-msg error';
          btn.disabled = false;
        });
    });
  })();
</script>

<style>
  .admin-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
  }

  .admin-title {
    font-size: 1.5rem;
    font-weight: 700;
    margin: 0 0 0.25rem;
    letter-spacing: -0.02em;
  }

  .admin-sub {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    margin: 0;
  }

  .btn-new {
    display: inline-block;
    padding: 0.5rem 1rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: white;
    background-color: var(--color-accent);
    text-decoration: none;
    border-radius: var(--radius-md);
    transition: background-color 0.2s;
    white-space: nowrap;
  }

  .btn-new:hover {
    background-color: var(--color-accent-hover);
  }

  .admin-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .admin-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 0.875rem 1rem;
    background-color: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    transition: border-color 0.2s;
  }

  .admin-item:hover {
    border-color: var(--color-text-muted);
  }

  .item-main {
    flex: 1;
    min-width: 0;
  }

  .item-title {
    display: block;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-text);
    margin-bottom: 0.375rem;
  }

  .item-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .badge-draft {
    display: inline-block;
    padding: 0.0625rem 0.5rem;
    font-size: 0.6875rem;
    font-weight: 500;
    color: #d97706;
    background-color: color-mix(in srgb, #f59e0b 15%, transparent);
    border-radius: var(--radius-sm);
  }

  .item-order {
    font-size: 0.6875rem;
    color: var(--color-text-muted);
  }

  .item-actions {
    display: flex;
    gap: 0.375rem;
    flex-shrink: 0;
  }

  .btn-edit {
    padding: 0.375rem 0.75rem;
    font-size: 0.8125rem;
    color: var(--color-text);
    text-decoration: none;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    transition: border-color 0.2s, color 0.2s;
  }

  .btn-edit:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .btn-delete {
    padding: 0.375rem 0.75rem;
    font-size: 0.8125rem;
    color: #dc2626;
    background: none;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: border-color 0.2s, background-color 0.2s;
  }

  .btn-delete:hover:not(:disabled) {
    border-color: #dc2626;
    background-color: color-mix(in srgb, #dc2626 8%, transparent);
  }

  .btn-delete:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .empty-state {
    text-align: center;
    padding: 3rem 1rem;
    color: var(--color-text-muted);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .del-msg {
    font-size: 0.8125rem;
    margin-top: 1rem;
    min-height: 1.2rem;
  }

  .del-msg.success {
    color: #059669;
  }

  .del-msg.error {
    color: #dc2626;
  }
</style>
