---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import BlogEditor from '../../../../components/BlogEditor.astro';
import { COLLECTIONS } from '../../../../server/collections';
import { getContent } from '../../../../server/github';

export const prerender = false;

const slug = Astro.params.slug as string;
const CONFIG = COLLECTIONS.blog;

let post: Awaited<ReturnType<typeof getContent>> = null;
let loadError = '';
try {
  post = await getContent(CONFIG, slug);
} catch (e: any) {
  loadError = e?.message || String(e);
}

// data.date 经 zod coerce.date() 解析为 Date 对象，需格式化为 YYYY-MM-DD 给 date input
function toDateInput(d: unknown): string {
  if (!d) return '';
  const date = d instanceof Date ? d : new Date(String(d));
  if (isNaN(date.getTime())) return '';
  const pad = (n: number) => String(n).padStart(2, '0');
  return `${date.getFullYear()}-${pad(date.getMonth() + 1)}-${pad(date.getDate())}`;
}
---

<BaseLayout title={post ? `编辑：${post.data.title}` : '编辑文章'}>
  <div class="page-header">
    <div>
      <a href="/admin" class="back-dash">← 管理中心</a>
      <h1 class="page-title">编辑文章</h1>
    </div>
    <a href="/admin/blog" class="back-link">← 返回列表</a>
  </div>

  {loadError ? (
    <div class="error-state">
      <p>加载失败：{loadError}</p>
      <p class="error-hint">请检查 GITHUB_TOKEN 配置与网络，或<a href="/admin/blog">返回列表</a>。</p>
    </div>
  ) : !post ? (
    <div class="error-state">
      <p>文章「{slug}」不存在。</p>
      <a href="/admin/blog" class="back-link">返回列表</a>
    </div>
  ) : (
    <BlogEditor
      mode="edit"
      slug={post.slug}
      sha={post.sha}
      initial={{
        title: post.data.title,
        description: post.data.description,
        date: toDateInput(post.data.date),
        tags: post.data.tags,
        draft: post.data.draft,
        body: post.body,
      }}
    />
  )}
</BaseLayout>

<style>
  .page-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 1.5rem;
    gap: 1rem;
  }

  .back-dash {
    display: inline-block;
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    text-decoration: none;
    margin-bottom: 0.5rem;
    transition: color 0.2s;
  }

  .back-dash:hover {
    color: var(--color-accent);
  }

  .page-title {
    font-size: 1.5rem;
    font-weight: 700;
    margin: 0;
    letter-spacing: -0.02em;
  }

  .back-link {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    text-decoration: none;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--color-accent);
  }

  .error-state {
    padding: 2rem 1.5rem;
    background-color: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    color: var(--color-text-secondary);
  }

  .error-state .error-hint {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    margin-top: 0.5rem;
  }

  .error-state a {
    color: var(--color-accent);
  }
</style>
