---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import ProjectEditor from '../../../../components/ProjectEditor.astro';
import { COLLECTIONS } from '../../../../server/collections';
import { getContent } from '../../../../server/github';

export const prerender = false;

const slug = Astro.params.slug as string;
const CONFIG = COLLECTIONS.projects;

let project: Awaited<ReturnType<typeof getContent>> = null;
let loadError = '';
try {
  project = await getContent(CONFIG, slug);
} catch (e: any) {
  loadError = e?.message || String(e);
}
---

<BaseLayout title={project ? `编辑：${project.data.name}` : '编辑项目'}>
  <div class="page-header">
    <div>
      <a href="/admin" class="back-dash">← 管理中心</a>
      <h1 class="page-title">编辑项目</h1>
    </div>
    <a href="/admin/projects" class="back-link">← 返回列表</a>
  </div>

  {loadError ? (
    <div class="error-state">
      <p>加载失败：{loadError}</p>
      <p class="error-hint">请检查 GITHUB_TOKEN 配置与网络，或<a href="/admin/projects">返回列表</a>。</p>
    </div>
  ) : !project ? (
    <div class="error-state">
      <p>项目「{slug}」不存在。</p>
      <a href="/admin/projects" class="back-link">返回列表</a>
    </div>
  ) : (
    <ProjectEditor
      mode="edit"
      slug={project.slug}
      sha={project.sha}
      initial={{
        name: project.data.name,
        description: project.data.description,
        techStack: project.data.techStack,
        demoUrl: project.data.demoUrl ? String(project.data.demoUrl) : '',
        repoUrl: project.data.repoUrl ? String(project.data.repoUrl) : '',
        status: project.data.status,
        featured: project.data.featured,
        body: project.body,
      }}
    />
  )}
</BaseLayout>

<style>
  .page-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 1.5rem;
    gap: 1rem;
  }

  .back-dash {
    display: inline-block;
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    text-decoration: none;
    margin-bottom: 0.5rem;
    transition: color 0.2s;
  }

  .back-dash:hover {
    color: var(--color-accent);
  }

  .page-title {
    font-size: 1.5rem;
    font-weight: 700;
    margin: 0;
    letter-spacing: -0.02em;
  }

  .back-link {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    text-decoration: none;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--color-accent);
  }

  .error-state {
    padding: 2rem 1.5rem;
    background-color: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    color: var(--color-text-secondary);
  }

  .error-state .error-hint {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    margin-top: 0.5rem;
  }

  .error-state a {
    color: var(--color-accent);
  }
</style>
