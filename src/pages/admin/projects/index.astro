---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export const prerender = false;

const allProjects = await getCollection('projects');

const statusOrder: Record<string, number> = { active: 0, concept: 1, archived: 2 };
const sortedProjects = allProjects.sort((a, b) => {
  const sa = statusOrder[a.data.status] ?? 99;
  const sb = statusOrder[b.data.status] ?? 99;
  if (sa !== sb) return sa - sb;
  return b.data.featured === a.data.featured ? 0 : b.data.featured ? -1 : 1;
});

const statusLabels: Record<string, string> = {
  active: '进行中',
  concept: '概念',
  archived: '已归档',
};
const statusColors: Record<string, string> = {
  active: 'status-active',
  concept: 'status-concept',
  archived: 'status-archived',
};
---

<BaseLayout title="项目管理">
  <div class="admin-header">
    <div>
      <a href="/admin" class="back-dash">← 管理中心</a>
      <h1 class="admin-title">项目管理</h1>
      <p class="admin-sub">共 {sortedProjects.length} 个 · 公开站每次保存后约 1–2 分钟自动重建</p>
    </div>
    <a href="/admin/projects/new" class="btn-new">+ 新建项目</a>
  </div>

  <div class="admin-list">
    {sortedProjects.length === 0 ? (
      <div class="empty-state">
        <p>暂无项目</p>
        <a href="/admin/projects/new" class="btn-new">添加第一个</a>
      </div>
    ) : (
      sortedProjects.map((project) => (
        <div class="admin-item" data-slug={project.id}>
          <div class="item-main">
            <div class="item-title-row">
              <span class="item-title">{project.data.name}</span>
              {project.data.featured && <span class="badge-featured">★ 精选</span>}
            </div>
            <div class="item-meta">
              <span class={`project-status ${statusColors[project.data.status]}`}>
                {statusLabels[project.data.status] ?? project.data.status}
              </span>
              {project.data.techStack.map((tech) => (
                <span class="tag">{tech}</span>
              ))}
            </div>
          </div>
          <div class="item-actions">
            <a href={`/admin/projects/${project.id}/edit`} class="btn-edit">编辑</a>
            <button type="button" class="btn-delete" data-delete-slug={project.id}>删除</button>
          </div>
        </div>
      ))
    )}
  </div>

  <p id="del-msg" class="del-msg"></p>
</BaseLayout>

<script is:inline>
  (function () {
    var msg = document.getElementById('del-msg');
    document.addEventListener('click', function (e) {
      var btn = e.target.closest('[data-delete-slug]');
      if (!btn) return;
      var slug = btn.getAttribute('data-delete-slug');
      if (!confirm('确认删除项目「' + slug + '」？此操作会从仓库移除文件并触发重建，不可撤销。')) return;

      msg.textContent = '删除中…';
      msg.className = 'del-msg';
      btn.disabled = true;

      fetch('/api/projects/' + encodeURIComponent(slug), { method: 'DELETE' })
        .then(function (res) {
          return res.json().then(function (j) {
            return { status: res.status, json: j };
          });
        })
        .then(function (r) {
          if (r.status >= 200 && r.status < 300 && r.json.ok) {
            var item = document.querySelector('.admin-item[data-slug="' + slug + '"]');
            if (item) item.remove();
            msg.textContent = '已删除，公开站稍后自动重建…';
            msg.className = 'del-msg success';
          } else {
            msg.textContent = r.json.error || '删除失败';
            msg.className = 'del-msg error';
            btn.disabled = false;
          }
        })
        .catch(function (err) {
          msg.textContent = '网络错误：' + err.message;
          msg.className = 'del-msg error';
          btn.disabled = false;
        });
    });
  })();
</script>

<style>
  .admin-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
  }

  .back-dash {
    display: inline-block;
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    text-decoration: none;
    margin-bottom: 0.5rem;
    transition: color 0.2s;
  }

  .back-dash:hover {
    color: var(--color-accent);
  }

  .admin-title {
    font-size: 1.5rem;
    font-weight: 700;
    margin: 0 0 0.25rem;
    letter-spacing: -0.02em;
  }

  .admin-sub {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    margin: 0;
  }

  .btn-new {
    display: inline-block;
    padding: 0.5rem 1rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: white;
    background-color: var(--color-accent);
    text-decoration: none;
    border-radius: var(--radius-md);
    transition: background-color 0.2s;
    white-space: nowrap;
  }

  .btn-new:hover {
    background-color: var(--color-accent-hover);
  }

  .admin-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .admin-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 0.875rem 1rem;
    background-color: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    transition: border-color 0.2s;
  }

  .admin-item:hover {
    border-color: var(--color-text-muted);
  }

  .item-main {
    flex: 1;
    min-width: 0;
  }

  .item-title-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.375rem;
  }

  .item-title {
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-text);
  }

  .badge-featured {
    font-size: 0.6875rem;
    font-weight: 500;
    color: #d97706;
    background-color: color-mix(in srgb, #f59e0b 15%, transparent);
    padding: 0.0625rem 0.5rem;
    border-radius: var(--radius-sm);
  }

  .item-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .project-status {
    font-size: 0.6875rem;
    font-weight: 500;
    padding: 0.0625rem 0.5rem;
    border-radius: var(--radius-full);
  }

  .status-active {
    color: #10b981;
    background-color: rgba(16, 185, 129, 0.1);
  }

  .status-concept {
    color: #f59e0b;
    background-color: rgba(245, 158, 11, 0.1);
  }

  .status-archived {
    color: #6b7280;
    background-color: rgba(107, 114, 128, 0.1);
  }

  .tag {
    font-size: 0.6875rem;
    padding: 0.0625rem 0.5rem;
    color: var(--color-text-secondary);
    background-color: var(--color-bg-secondary);
    border-radius: var(--radius-sm);
  }

  .item-actions {
    display: flex;
    gap: 0.375rem;
    flex-shrink: 0;
  }

  .btn-edit {
    padding: 0.375rem 0.75rem;
    font-size: 0.8125rem;
    color: var(--color-text);
    text-decoration: none;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    transition: border-color 0.2s, color 0.2s;
  }

  .btn-edit:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .btn-delete {
    padding: 0.375rem 0.75rem;
    font-size: 0.8125rem;
    color: #dc2626;
    background: none;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: border-color 0.2s, background-color 0.2s;
  }

  .btn-delete:hover:not(:disabled) {
    border-color: #dc2626;
    background-color: color-mix(in srgb, #dc2626 8%, transparent);
  }

  .btn-delete:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .empty-state {
    text-align: center;
    padding: 3rem 1rem;
    color: var(--color-text-muted);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .del-msg {
    font-size: 0.8125rem;
    margin-top: 1rem;
    min-height: 1.2rem;
  }

  .del-msg.success {
    color: #059669;
  }

  .del-msg.error {
    color: #dc2626;
  }
</style>
