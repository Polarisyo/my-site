---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog', ({ data }) => !data.draft);
const projects = await getCollection('projects', ({ data }) => data.featured);

const recentPosts = posts
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<BaseLayout title="首页">
  <section class="hero">
    <h1 class="hero-title">你好，我是 <span class="accent">Polaris</span></h1>
    <p class="hero-desc">
      一个热爱技术与创造的开发者。这里是我的数字花园，记录日常思考、学习笔记和作品展示。
    </p>
  </section>

  <section class="section">
    <div class="section-header">
      <h2 class="section-title">最新文章</h2>
      <a href="/blog" class="section-link">查看全部 →</a>
    </div>
    <div class="post-list">
      {recentPosts.map((post) => (
        <a href={`/blog/${post.id}`} class="post-item">
          <span class="post-title">{post.data.title}</span>
          <time class="post-date" datetime={post.data.date.toISOString()}>
            {post.data.date.toLocaleDateString('zh-CN', {
              year: 'numeric',
              month: 'long',
              day: 'numeric',
            })}
          </time>
        </a>
      ))}
    </div>
  </section>

  {projects.length > 0 && (
    <section class="section">
      <div class="section-header">
        <h2 class="section-title">精选项目</h2>
        <a href="/projects" class="section-link">查看全部 →</a>
      </div>
      <div class="project-list">
        {projects.map((project) => (
          <a href={`/projects/${project.id}`} class="project-item">
            <div class="project-info">
              <h3 class="project-name">{project.data.name}</h3>
              <p class="project-desc">{project.data.description}</p>
              <div class="project-tags">
                {project.data.techStack.map((tech) => (
                  <span class="tag">{tech}</span>
                ))}
              </div>
            </div>
          </a>
        ))}
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .hero {
    padding: 1rem 0 2.5rem;
  }

  .hero-title {
    font-size: 1.875rem;
    font-weight: 700;
    line-height: 1.3;
    margin: 0 0 0.75rem;
    letter-spacing: -0.02em;
  }

  .accent {
    color: var(--color-accent);
  }

  .hero-desc {
    font-size: 1rem;
    color: var(--color-text-secondary);
    line-height: 1.7;
    margin: 0;
  }

  .section {
    margin-bottom: 2.5rem;
  }

  .section-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 1rem;
  }

  .section-title {
    font-size: 1.25rem;
    font-weight: 600;
    margin: 0;
  }

  .section-link {
    font-size: 0.875rem;
    color: var(--color-accent);
    text-decoration: none;
    transition: color 0.2s;
  }

  .section-link:hover {
    color: var(--color-accent-hover);
  }

  .post-list {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .post-item {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 0.625rem 0;
    border-bottom: 1px solid var(--color-border);
    text-decoration: none;
    transition: padding-left 0.2s;
  }

  .post-item:hover {
    padding-left: 0.5rem;
  }

  .post-title {
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-text);
  }

  .post-item:hover .post-title {
    color: var(--color-accent);
  }

  .post-date {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    flex-shrink: 0;
    margin-left: 1rem;
  }

  .project-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .project-item {
    display: block;
    padding: 1rem 1.25rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    text-decoration: none;
    transition: border-color 0.2s, box-shadow 0.2s;
    background-color: var(--color-bg-card);
  }

  .project-item:hover {
    border-color: var(--color-accent);
    box-shadow: var(--shadow-md);
  }

  .project-name {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-text);
    margin: 0 0 0.375rem;
  }

  .project-desc {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    margin: 0 0 0.625rem;
    line-height: 1.5;
  }

  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }

  @media (max-width: 768px) {
    .hero-title {
      font-size: 1.5rem;
    }

    .post-item {
      flex-direction: column;
      gap: 0.125rem;
    }

    .post-date {
      margin-left: 0;
    }
  }
</style>