---
import BaseLayout from '../layouts/BaseLayout.astro';

export const prerender = false;

// 已登录直接进后台
if (Astro.locals.session) {
  return Astro.redirect('/admin');
}
---

<BaseLayout title="登录">
  <div class="login-wrap">
    <form id="login-form" class="login-form">
      <h1 class="login-title">秘密花园</h1>
      <p class="login-sub">仅限管理员</p>
      <input
        name="password"
        type="password"
        class="login-input"
        placeholder="密码"
        autocomplete="current-password"
        required
      />
      <button type="submit" class="login-btn" id="login-btn">进入</button>
      <p id="login-msg" class="login-msg"></p>
    </form>
  </div>
</BaseLayout>

<script is:inline>
  (function () {
    var form = document.getElementById('login-form');
    if (!form) return;
    var btn = document.getElementById('login-btn');
    var msg = document.getElementById('login-msg');

    form.addEventListener('submit', function (e) {
      e.preventDefault();
      msg.textContent = '';
      msg.className = 'login-msg';
      btn.disabled = true;
      btn.textContent = '验证中…';

      fetch('/api/auth/login', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ password: form.password.value }),
      })
        .then(function (res) {
          return res.json().then(function (j) {
            return { status: res.status, json: j };
          });
        })
        .then(function (r) {
          if (r.status >= 200 && r.status < 300 && r.json.ok) {
            window.location.href = '/admin';
          } else {
            msg.textContent = r.json.error || '登录失败';
            msg.className = 'login-msg error';
            btn.disabled = false;
            btn.textContent = '进入';
            form.password.select();
          }
        })
        .catch(function (err) {
          msg.textContent = '网络错误：' + err.message;
          msg.className = 'login-msg error';
          btn.disabled = false;
          btn.textContent = '进入';
        });
    });
  })();
</script>

<style>
  .login-wrap {
    display: flex;
    justify-content: center;
    padding: 4rem 1rem;
  }

  .login-form {
    width: 100%;
    max-width: 22rem;
    background-color: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
    padding: 2rem 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }

  .login-title {
    font-size: 1.5rem;
    font-weight: 700;
    margin: 0;
    text-align: center;
    letter-spacing: -0.02em;
  }

  .login-sub {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    text-align: center;
    margin: 0 0 0.5rem;
  }

  .login-input {
    width: 100%;
    padding: 0.625rem 0.75rem;
    font-size: 0.9375rem;
    background-color: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    color: var(--color-text);
    outline: none;
    transition: border-color 0.2s, box-shadow 0.2s;
  }

  .login-input:focus {
    border-color: var(--color-accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-accent) 20%, transparent);
  }

  .login-btn {
    padding: 0.625rem 1rem;
    font-size: 0.9375rem;
    font-weight: 500;
    color: white;
    background-color: var(--color-accent);
    border: none;
    border-radius: var(--radius-md);
    cursor: pointer;
    transition: background-color 0.2s;
  }

  .login-btn:hover:not(:disabled) {
    background-color: var(--color-accent-hover);
  }

  .login-btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .login-msg {
    font-size: 0.8125rem;
    min-height: 1.2rem;
    text-align: center;
    margin: 0;
  }

  .login-msg.error {
    color: #dc2626;
  }
</style>
