---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';

const pageTitle = '搜索';
const pageDescription = '搜索文章、笔记和项目';
---

<BaseLayout title={`${pageTitle} · 数字花园`} description={pageDescription}>
  <Header title={pageTitle} />

  <div class="search-container">
    <div class="search-box">
      <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="8"/>
        <path d="m21 21-4.3-4.3"/>
      </svg>
      <input
        id="search-input"
        type="search"
        placeholder="输入关键词搜索文章、笔记、项目…"
        autocomplete="off"
        autofocus
      />
      <kbd class="search-shortcut">/</kbd>
    </div>

    <div id="search-stats" class="search-stats"></div>

    <div id="search-results" class="search-results"></div>

    <div id="search-empty" class="search-empty">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="8"/>
        <path d="m21 21-4.3-4.3"/>
      </svg>
      <p>开始输入以搜索站内内容</p>
      <div class="search-hints">
        <span>支持按标题、描述、标签、正文搜索</span>
      </div>
    </div>
  </div>
</BaseLayout>

<script is:inline>
  (function () {
    var TYPE_LABELS = {
      blog: { label: '博客', class: 'tag-blog' },
      notes: { label: '笔记', class: 'tag-notes' },
      projects: { label: '项目', class: 'tag-projects' },
    };

    var input = document.getElementById('search-input');
    var resultsEl = document.getElementById('search-results');
    var emptyEl = document.getElementById('search-empty');
    var statsEl = document.getElementById('search-stats');
    var docs = [];
    var loaded = false;

    fetch('/search-data.json')
      .then(function (res) { return res.json(); })
      .then(function (data) {
        docs = data;
        loaded = true;
        if (input.value.trim()) {
          doSearch(input.value.trim());
        }
      })
      .catch(function () {
        statsEl.textContent = '搜索数据加载失败';
      });

    function doSearch(query) {
      if (!loaded) {
        statsEl.textContent = '搜索加载中…';
        return;
      }

      query = query.trim();
      if (!query) {
        resultsEl.innerHTML = '';
        statsEl.textContent = '';
        emptyEl.style.display = '';
        emptyEl.querySelector('p').textContent = '开始输入以搜索站内内容';
        return;
      }

      var queryLower = query.toLowerCase();
      var matched = docs.filter(function (doc) {
        var haystack = [
          doc.title,
          doc.description || '',
          (doc.tags || []).join(' '),
          doc.body || ''
        ].join(' ').toLowerCase();
        return haystack.indexOf(queryLower) !== -1;
      });

      matched.sort(function (a, b) {
        var aScore = getScore(a, queryLower);
        var bScore = getScore(b, queryLower);
        return bScore - aScore;
      });

      statsEl.textContent = '找到 ' + matched.length + ' 条结果';
      resultsEl.innerHTML = '';

      if (matched.length === 0) {
        emptyEl.style.display = '';
        emptyEl.querySelector('p').textContent = '没有找到与 "' + query + '" 相关的内容';
        return;
      }

      emptyEl.style.display = 'none';

      matched.slice(0, 50).forEach(function (doc) {
        var typeInfo = TYPE_LABELS[doc.type] || { label: doc.type, class: '' };
        var item = document.createElement('a');
        item.href = doc.url;
        item.className = 'search-result-item';

        var title = document.createElement('div');
        title.className = 'result-title';
        title.innerHTML = highlight(doc.title, query);

        var meta = document.createElement('div');
        meta.className = 'result-meta';

        var typeTag = document.createElement('span');
        typeTag.className = 'result-tag tag ' + typeInfo.class;
        typeTag.textContent = typeInfo.label;
        meta.appendChild(typeTag);

        if (doc.date) {
          var date = document.createElement('span');
          date.className = 'result-date';
          date.textContent = formatDate(doc.date);
          meta.appendChild(date);
        }

        if (doc.tags && doc.tags.length) {
          doc.tags.slice(0, 3).forEach(function (t) {
            var tag = document.createElement('span');
            tag.className = 'result-tag';
            tag.textContent = '#' + t;
            meta.appendChild(tag);
          });
        }

        var desc = document.createElement('div');
        desc.className = 'result-desc';
        desc.innerHTML = highlight(doc.description || '', query);

        item.appendChild(title);
        item.appendChild(meta);
        if (desc.textContent.trim()) {
          item.appendChild(desc);
        }

        resultsEl.appendChild(item);
      });
    }

    function getScore(doc, query) {
      var score = 0;
      var titleLower = doc.title.toLowerCase();
      var descLower = (doc.description || '').toLowerCase();
      var tagsLower = (doc.tags || []).join(' ').toLowerCase();
      var bodyLower = (doc.body || '').toLowerCase();

      if (titleLower.indexOf(query) !== -1) score += 100;
      if (tagsLower.indexOf(query) !== -1) score += 50;
      if (descLower.indexOf(query) !== -1) score += 30;
      if (bodyLower.indexOf(query) !== -1) score += 10;
      return score;
    }

    function highlight(text, query) {
      if (!query) return text;
      var escaped = query.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
      var regex = new RegExp('(' + escaped + ')', 'gi');
      return text.replace(regex, '<mark>$1</mark>');
    }

    function formatDate(iso) {
      try {
        var d = new Date(iso);
        return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
      } catch (e) {
        return '';
      }
    }

    input.addEventListener('input', function (e) {
      doSearch(e.target.value);
    });

    document.addEventListener('keydown', function (e) {
      if (e.key === '/' && document.activeElement !== input) {
        e.preventDefault();
        input.focus();
        input.select();
      }
      if (e.key === 'Escape') {
        input.value = '';
        doSearch('');
      }
    });
  })();
</script>

<style>
  .search-container {
    max-width: 44rem;
    margin: 0 auto;
    padding: 2rem 0;
  }

  .search-box {
    position: relative;
    margin-bottom: 1rem;
  }

  .search-icon {
    position: absolute;
    left: 0.875rem;
    top: 50%;
    transform: translateY(-50%);
    width: 1.125rem;
    height: 1.125rem;
    color: var(--color-text-muted);
    pointer-events: none;
  }

  #search-input {
    width: 100%;
    padding: 0.875rem 2.75rem 0.875rem 2.75rem;
    font-size: 1rem;
    background-color: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    color: var(--color-text);
    outline: none;
    transition: border-color 0.2s, box-shadow 0.2s;
  }

  #search-input:focus {
    border-color: var(--color-accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-accent) 20%, transparent);
  }

  .search-shortcut {
    position: absolute;
    right: 0.875rem;
    top: 50%;
    transform: translateY(-50%);
    padding: 0.125rem 0.5rem;
    font-size: 0.75rem;
    color: var(--color-text-muted);
    background-color: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    pointer-events: none;
  }

  .search-stats {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    margin-bottom: 1rem;
    min-height: 1.25rem;
  }

  .search-results {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .search-result-item {
    display: block;
    padding: 1rem 1.25rem;
    background-color: var(--color-bg-secondary);
    border: 1px solid transparent;
    border-radius: var(--radius-lg);
    text-decoration: none;
    transition: border-color 0.2s, background-color 0.2s, transform 0.15s;
  }

  .search-result-item:hover {
    border-color: var(--color-accent);
    background-color: color-mix(in srgb, var(--color-accent) 8%, var(--color-bg-secondary));
    transform: translateY(-1px);
  }

  .result-title {
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: 0.5rem;
    line-height: 1.4;
  }

  .result-title mark,
  .result-desc mark {
    background-color: color-mix(in srgb, var(--color-accent) 25%, transparent);
    color: inherit;
    padding: 0 0.125rem;
    border-radius: 2px;
  }

  .result-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
    flex-wrap: wrap;
  }

  .result-tag {
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  .result-tag.tag {
    padding: 0.125rem 0.5rem;
    border-radius: var(--radius-sm);
    font-weight: 500;
  }

  .tag-blog {
    background-color: color-mix(in srgb, #3b82f6 15%, transparent);
    color: #2563eb;
  }

  .tag-notes {
    background-color: color-mix(in srgb, #10b981 15%, transparent);
    color: #059669;
  }

  .tag-projects {
    background-color: color-mix(in srgb, #f59e0b 15%, transparent);
    color: #d97706;
  }

  .dark .tag-blog { color: #60a5fa; }
  .dark .tag-notes { color: #34d399; }
  .dark .tag-projects { color: #fbbf24; }

  .result-date {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }

  .result-desc {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .search-empty {
    text-align: center;
    padding: 3rem 1rem;
    color: var(--color-text-muted);
  }

  .search-empty svg {
    width: 3rem;
    height: 3rem;
    margin: 0 auto 1rem;
    opacity: 0.4;
  }

  .search-empty p {
    font-size: 1rem;
    margin-bottom: 0.5rem;
  }

  .search-hints span {
    font-size: 0.8125rem;
    opacity: 0.7;
  }

  @media (max-width: 768px) {
    .search-container {
      padding: 1rem 0;
    }
  }
</style>